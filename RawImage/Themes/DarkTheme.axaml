<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dracula Theme Colors -->
    <Style>
        <Style.Resources>
            <!-- Dracula color palette -->
            <Color x:Key="BackgroundColor">#282a36</Color>
            <Color x:Key="SurfaceColor">#44475a</Color>
            <Color x:Key="CurrentLineColor">#44475a</Color>
            <Color x:Key="ForegroundColor">#f8f8f2</Color>
            <Color x:Key="CommentColor">#6272a4</Color>
            <Color x:Key="CyanColor">#8be9fd</Color>
            <Color x:Key="GreenColor">#50fa7b</Color>
            <Color x:Key="OrangeColor">#ffb86c</Color>
            <Color x:Key="PinkColor">#ff79c6</Color>
            <Color x:Key="PurpleColor">#bd93f9</Color>
            <Color x:Key="RedColor">#ff5555</Color>
            <Color x:Key="YellowColor">#f1fa8c</Color>

            <!-- Derived colors -->
            <Color x:Key="TitleBarColor">#21222c</Color>
            <Color x:Key="DarkerBackgroundColor">#1e1f29</Color>
            <Color x:Key="BorderColor">#44475a</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#282a36" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#44475a" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="#f8f8f2" />
            <SolidColorBrush x:Key="CommentBrush" Color="#6272a4" />
            <SolidColorBrush x:Key="AccentBrush" Color="#bd93f9" />
            <SolidColorBrush x:Key="CyanBrush" Color="#8be9fd" />
            <SolidColorBrush x:Key="GreenBrush" Color="#50fa7b" />
            <SolidColorBrush x:Key="RedBrush" Color="#ff5555" />
            <SolidColorBrush x:Key="YellowBrush" Color="#f1fa8c" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#21222c" />
            <SolidColorBrush x:Key="DarkerBackgroundBrush" Color="#1e1f29" />
            <SolidColorBrush x:Key="BorderBrush" Color="#44475a" />
            <SolidColorBrush x:Key="ScrollBarBrush" Color="#44475a" />
        </Style.Resources>
    </Style>

    <!-- Window styling -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#282a36" />
        <Setter Property="Foreground" Value="#f8f8f2" />
    </Style>

    <!-- TextBlock styling -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#f8f8f2" />
    </Style>

    <!-- Button styling - Modern minimal -->
    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#f8f8f2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#44475a" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#3a3c4e" />
    </Style>

    <!-- Window control button - Close -->
    <Style Selector="Button.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#ff5555" />
    </Style>

    <!-- TextBox styling - Modern with focus state -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#1e1f29" />
        <Setter Property="Foreground" Value="#f8f8f2" />
        <Setter Property="BorderBrush" Value="#44475a" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SelectionBrush" Value="#44475a" />
        <Setter Property="CaretBrush" Value="#f8f8f2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#bd93f9" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="#6272a4" />
    </Style>

    <!-- Menu styling -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#f8f8f2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#44475a" />
    </Style>

    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#44475a" />
    </Style>

    <!-- Menu popup styling -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="#282a36" />
        <Setter Property="BorderBrush" Value="#44475a" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="#282a36" />
        <Setter Property="BorderBrush" Value="#44475a" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Separator styling -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="#44475a" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- TreeView styling -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="#282a36" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="#f8f8f2" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#363848" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#44475a" />
    </Style>

    <!-- ScrollBar styling - Minimal -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#44475a" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#6272a4" />
    </Style>

    <!-- GridSplitter styling -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="#21222c" />
    </Style>

    <!-- Border styling for panels -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="#21222c" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- CheckBox styling -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#f8f8f2" />
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#bd93f9" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#bd93f9" />
        <Setter Property="BorderBrush" Value="#bd93f9" />
    </Style>

    <!-- RadioButton styling -->
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="#f8f8f2" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="#bd93f9" />
    </Style>

    <Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="#bd93f9" />
    </Style>

    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="#bd93f9" />
    </Style>

    <!-- ToolTip styling -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#21222c" />
        <Setter Property="Foreground" Value="#f8f8f2" />
        <Setter Property="BorderBrush" Value="#44475a" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- Custom icon paths -->
    <Style>
        <Style.Resources>
            <StreamGeometry x:Key="LockIcon">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</StreamGeometry>
            <StreamGeometry x:Key="UnlockIcon">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H15V6A3,3 0 0,0 9,6C7.9,6 7,6.9 7,8H5A5,5 0 0,1 12,3A5,5 0 0,1 17,6V8H18Z</StreamGeometry>
            <StreamGeometry x:Key="ChevronLeftIcon">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</StreamGeometry>
            <StreamGeometry x:Key="ChevronRightIcon">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
            <StreamGeometry x:Key="FolderIcon">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="FileImageIcon">M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z</StreamGeometry>
            <StreamGeometry x:Key="MinimizeIcon">M20,14H4V10H20</StreamGeometry>
            <StreamGeometry x:Key="MaximizeIcon">M4,4H20V20H4V4M6,8V18H18V8H6Z</StreamGeometry>
            <StreamGeometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
            <StreamGeometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        </Style.Resources>
    </Style>
</Styles>
